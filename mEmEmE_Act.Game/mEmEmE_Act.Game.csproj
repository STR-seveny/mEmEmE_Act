<Project Sdk="Microsoft.NET.Sdk">
   <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
     <ImplicitUsings>enable</ImplicitUsings>
     <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
   <ItemGroup>
     <None Remove="Resources\Fonts\SourceHanSansSC-Regular.otf" />
   </ItemGroup>
   <ItemGroup>
     <Content Include="Resources\Fonts\SourceHanSansSC-Regular.otf">
       <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
     </Content>
   </ItemGroup>
  <!--
    Runtime assets are embedded INTO this assembly as well as copied next to the executable.

    Copied alone they only exist on desktop: on Android the build output is inside the app package, so
    every path built from AppDomain.BaseDirectory resolves to nothing and the game dies on the missing
    font. Embedded, the same bytes are reachable on every platform through GetManifestResourceStream,
    which is what GameAssets uses. See GameAssets.cs.

    Globs rather than literal names on purpose: menu.mp3 and the levels are not in the repository, and
    a literal Include of a file that is not there fails the build.
  -->
  <ItemGroup Label="Embedded runtime assets">
    <EmbeddedResource Include="Resources\Fonts\*.otf" />
    <EmbeddedResource Include="Resources\Sound\*.mp3" />
    <EmbeddedResource Include="Resources\Textures\*.png" />
    <EmbeddedResource Include="Resources\Effects\*.png" />
    <EmbeddedResource Include="Resources\Levels\*.me4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\mEmEmE_Act.Resources\mEmEmE_Act.Resources.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FontStashSharp.PlatformAgnostic" Version="1.6.1" />
    <PackageReference Include="FontStashSharp.Rasterizers.StbTrueTypeSharp" Version="1.2.9" />
    <PackageReference Include="ppy.osu.Framework" Version="2025.1021.0" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources\Audio\1_1_1.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Charts\1_1_1.me3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Levels\The 456th Dream.me4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Levels\Timeous.me4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Sound\hit.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Effects\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Levels\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Sound\menu.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Textures are loose files loaded at runtime from Resources\Textures, so they have to be
         copied next to the executable. A wildcard is used because this was repeatedly forgotten for
         new files (logo.png, START.png) and the game silently fell back to a placeholder. -->
    <None Update="Resources\Textures\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
