<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <!-- targetSdkVersion has to be stated HERE, not as an MSBuild property: the packer merges a
       targetSdkVersion of 28 in from a library manifest, and a phone on Android 16 refuses (or half
       refuses) to install an app targeting something that old. 34 is the highest this workload
       supports (Microsoft.Android.Ref.34). -->
  <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

  <!-- SDL (and therefore osu!framework) renders through OpenGL ES 2.0 at minimum. -->
  <uses-feature android:glEsVersion="0x00020000" android:required="true" />

  <!-- No icon is declared on purpose: the app falls back to the launcher's default rather than
       referencing a mipmap that does not exist yet. Add Resources/mipmap-*/ic_launcher.png and
       android:icon="@mipmap/ic_launcher" here when there is artwork for it. -->
  <application android:allowBackup="true"
               android:supportsRtl="true"
               android:label="mEmEmE(Act)"
               android:hardwareAccelerated="true" />
</manifest>
