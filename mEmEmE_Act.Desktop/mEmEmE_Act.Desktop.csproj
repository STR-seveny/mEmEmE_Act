<Project Sdk="Microsoft.NET.Sdk">
   <PropertyGroup Label="Project">
    <TargetFramework>net8.0</TargetFramework>
     <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <AssemblyName>mEmEmE_Act</AssemblyName>
    <ApplicationIcon>game.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="game.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="game.ico" />
  </ItemGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\mEmEmE_Act.Game\mEmEmE_Act.Game.csproj" />
  </ItemGroup>

  <!--
    Levels (.me4 packages) live in the Game project's Resources\Levels but are NOT in the
    repository — .gitignore excludes *.me4, so a fresh clone has none. Copy whatever is there
    into this (the executable's) output folder so the game can find it at runtime.

    Done with a target that filters the item list rather than <None Update="...*.me4">, because
    an include of *.me4 that matches nothing would fail the build.
  -->
  <Target Name="CopyLevels" AfterTargets="Build">
    <ItemGroup>
      <LevelFiles Include="$(MSBuildProjectDirectory)\..\mEmEmE_Act.Game\Resources\Levels\*.me4" />
    </ItemGroup>

    <Copy SourceFiles="@(LevelFiles)"
          DestinationFolder="$(OutDir)Resources\Levels"
          SkipUnchangedFiles="true"
          Condition="'@(LevelFiles)' != ''" />

    <Message Importance="normal"
             Text="CopyLevels: @(LevelFiles->'%(Filename)%(Extension)', ', ')"
             Condition="'@(LevelFiles)' != ''" />
  </Target>
</Project>
